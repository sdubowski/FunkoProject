@inherits MainLayoutBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            @if (!isUserLoggedIn)
            {
                <a href="login">Login</a>
                <a href="register">Register</a>
            }
            else
            {
                <a @onclick="Logout">Wyloguj</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>



