@page "/file-upload"
@inherits UploadImageModalBase

<div class="modal show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Zmień zdjęcie profilowe</h5>
                <button type="button" class="close" @onclick="HandleCancel" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <label for="file-upload" class="btn btn-outline-primary btn-lg mb-3" style="cursor:pointer;">
                    <i class="fas fa-cloud-upload-alt me-2"></i> Wybierz plik
                </label>
                <InputFile id="file-upload" OnChange="HandleFileSelected" hidden />

                @if (IsFileSelected)
                {
                    <div class="file-info mt-3 d-flex justify-content-between align-items-center px-3 py-2 border rounded">
                        <span class="text-truncate" style="max-width: 70%;">@FileModel.FileName</span>
                        <button class="btn btn-sm btn-danger" @onclick="RemoveFile" title="Usuń plik">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Anuluj</button>
                <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(!IsFileSelected || string.IsNullOrEmpty(UserId))">Zapisz</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal backdrop -->
<div class="modal-backdrop fade show"></div>
