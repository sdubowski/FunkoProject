@page "/ProfilePage"
@attribute [Authorize]
@using FunkoProject.Web.Components.FigureComponents
@using FunkoProject.Web.Components.Modals
@using FunkoProject.Web.Enums
@using Microsoft.AspNetCore.Authorization
@using FunkoProject.Web.Components

<div class="container mt-5">
    <h2>Profil użytkownika</h2>

    <div class="row">
        <div class="col-md-4">
            @if (file == null || string.IsNullOrEmpty(file.Data))
            {
                <p>Ładowanie danych....</p>
            }
            else
            {
                <img src="data:@file.ContentType;base64,@file.Data" alt="Profile Image" class="img-fluid rounded-circle" style="width: 200px; height: 200px;" />
            }
        </div>
        <div class="col-md-8">
            <h3>@user.FirstName @user.LastName</h3>
            <p><strong>Email:</strong> @user.Email</p>
            <p><strong>Data urodzenia:</strong> @user.DateOfBirth?.ToString("dd.MM.yyyy")</p>
            <p><strong>Ilość figurek:</strong> @userFigures</p>

            <button class="btn btn-primary" @onclick="() => OpenEditModal(ModalTypeEnum.Edit)">Edytuj profil</button>
            <button class="btn btn-primary" @onclick="() => OpenEditModal(ModalTypeEnum.Upload)">Zmień zdjęcie</button>
        </div>
    </div>

    <hr/>

    @* <UserFigures Figures="@userFigure"></UserFigures> *@
    
    @if (isEditModalOpen)
    {
        <UserEditModal User="user" OnSave="SaveChanges" OnCancel="() => CloseEditModal(ModalTypeEnum.Edit)" />
    }
    @if (isUploadModalOpen)
    {
        <UploadImageModal UserId="@user.Id.ToString()" OnCancel="() => CloseEditModal(ModalTypeEnum.Upload)" OnUploadComplete="RefreshProfileImage"></UploadImageModal>
    }
</div>
<div>
    <UserFigures Figures="userFigure"/>
</div>
